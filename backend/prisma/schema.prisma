// =========================
// PRISMA CONFIG
// =========================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// ENUMS

enum Role {
  SUPERADMIN
  DIRECTEUR
  GERANT
  VENDEUR
  MAGASINIER
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
}

// TENANT (COMMERCE)

model Tenant {
  id               String   @id @default(uuid())
  name             String
  domain           String   @unique
  subscriptionPlan SubscriptionPlan @default(FREE)

  users            User[]
  products         Product[]
  sales            Sale[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// USER

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  role        Role

  // SUPERADMIN n'a pas de tenant
  tenantId    String?
  tenant      Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  is2FAEnabled Boolean @default(false)

  sales       Sale[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([role])
}

// PRODUCT (STOCK)

model Product {
  id        String   @id @default(uuid())
  name      String
  price     Decimal  @db.Decimal(10,2)
  stock     Int

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  saleItems SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([name])
}

// SALE (VENTE)

model Sale {
  id          String   @id @default(uuid())
  totalAmount Decimal  @db.Decimal(12,2)

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  items       SaleItem[]

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
}

// SALE ITEM (LIGNES DE VENTE)

model SaleItem {
  id        String   @id @default(uuid())
  quantity  Int
  price     Decimal  @db.Decimal(10,2)

  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}
